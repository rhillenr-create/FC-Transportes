rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que usuários autenticados leiam e escrevam em qualquer coleção
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Regra específica para perfis de usuário, se necessário no futuro
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}