
{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Dados de perfil do gestor ou motorista da frota.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID único do usuário no Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "E-mail corporativo" },
        "displayName": { "type": "string", "description": "Nome completo" },
        "role": { "type": "string", "enum": ["admin", "driver"], "description": "Nível de acesso" }
      },
      "required": ["uid", "email"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Coleção de perfis de usuários do sistema"
    }
  }
}
