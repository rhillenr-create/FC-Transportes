{
  "entities": {
    "UserProfile": {
      "title": "Perfil do Usuário",
      "description": "Dados de perfil do gestor ou motorista da frota.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "ID único do usuário no Firebase Auth" },
        "email": { "type": "string", "format": "email", "description": "E-mail corporativo" },
        "displayName": { "type": "string", "description": "Nome completo" },
        "role": { "type": "string", "enum": ["admin", "driver"], "description": "Nível de acesso" }
      },
      "required": ["uid", "email"]
    },
    "Truck": {
      "title": "Veículo",
      "description": "Dados técnicos e operacionais de um caminhão da frota.",
      "type": "object",
      "properties": {
        "plate": { "type": "string", "description": "Placa do veículo" },
        "model": { "type": "string", "description": "Modelo/Marca" },
        "year": { "type": "number", "description": "Ano de fabricação" },
        "km": { "type": "number", "description": "Quilometragem atual" },
        "avg": { "type": "number", "description": "Média de consumo KM/L" },
        "status": { "type": "string", "enum": ["Disponível", "Em Viagem", "Manutenção"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["plate", "model"]
    },
    "Trip": {
      "title": "Viagem / Frete",
      "description": "Registro de operação logística e transporte.",
      "type": "object",
      "properties": {
        "origin": { "type": "string", "description": "Cidade de origem" },
        "destination": { "type": "string", "description": "Cidade de destino" },
        "client": { "type": "string", "description": "Nome do cliente" },
        "driver": { "type": "string", "description": "Nome do motorista" },
        "truck": { "type": "string", "description": "Placa do caminhão" },
        "freight": { "type": "string", "description": "Valor do frete formatado" },
        "status": { "type": "string", "enum": ["Pendente", "Em Rota", "Concluída"] },
        "progress": { "type": "number", "description": "Percentual de progresso (0-100)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["origin", "destination", "client", "driver", "truck"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "Coleção de perfis de usuários do sistema"
    },
    "/trucks/{truckId}": {
      "schema": "#/backend/entities/Truck",
      "description": "Cadastro central de veículos da frota"
    },
    "/trips/{tripId}": {
      "schema": "#/backend/entities/Trip",
      "description": "Gestão de viagens e logística"
    }
  }
}
